<Window x:Class="LoginDemo.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LoginDemo"
        mc:Ignorable="d"
        Title="LoginWindow" Height="900" Width="1600">
    <Grid>
        <Grid.Background>
            <SolidColorBrush Color="#F4F7FC"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="8*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Background="Transparent" Grid.Column="1"/>
        <TextBlock Grid.Column="1" Text="LogIn System" Background="Transparent" Foreground="#1E3A8A" FontSize="60" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.12" Color="#000000"/>
            </TextBlock.Effect>
        </TextBlock>

        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.Background>
                <SolidColorBrush Color="#FFFFFF"/>
            </Grid.Background>
            <Grid.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.08" Color="#1E3A8A"/>
            </Grid.Effect>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="1*" />
                <RowDefinition Height="4*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Background="Transparent" Text="UserName" FontSize="100" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Text="{Binding UserName}" Grid.Column="1" Background="White" Height="85" Width="550" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="80" Foreground="#1E293B" BorderBrush="#94A3B8" BorderThickness="1.5" CaretBrush="#3B82F6"/>
            </Grid>

            <Grid Grid.Row="1" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Background="Transparent" Text="PassWord" FontSize="100" Foreground="#334155" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PassWord}" Grid.Column="1" Background="White" Height="85" Width="550" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="80" Foreground="#1E293B" BorderBrush="#94A3B8" BorderThickness="1.5" CaretBrush="#3B82F6"/>
            </Grid>

            <Grid Grid.Row="2" Background="Transparent">
                <CheckBox Content="Remember PassWord" HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="300" FontSize="24" Foreground="#475569" Background="Transparent" BorderBrush="#CBD5E1"/>
            </Grid>

            <Grid Grid.Row="3" Background="Transparent">
                <Border Background="#2563EB" Height="150" Width="400" CornerRadius="35">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#1E3A8A"/>
                    </Border.Effect>
                    <Button Background="Transparent" Content="Log In" Foreground="White" FontSize="100" Height="140" Width="380" FontWeight="SemiBold" Command="{Binding LogInAction}" BorderThickness="0"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="2">
            <Button Background="Transparent" Height="60" Width="150" Content="Forget PassWord" FontSize="15" Foreground="#3B82F6" BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>